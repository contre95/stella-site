      "tags": ["beginner"],
      "cover": ["#ec4899", "#7c3aed"],
      "study": { "startDaysAgo": 3, "newPerDay": 3 },
      "facts": [
        { "front": "{center}What is Stella?{/center}", "back": "{center}A self-hosted **spaced-repetition** app.\nIt shows you each card right before you'd forget it.{/center}" },
        { "front": "{center}How do I grade a card?{/center}", "back": "From **0** (blackout) to **5** (perfect recall).\n\n- 0-1: you'll see it again today\n- 2-5: it comes back in days, then weeks, then months" },
        { "front": "{center}Cards are *Markdown*{/center}", "back": "**bold**, *italic*, lists and [links](https://github.com/contre95/stella):\n\n1. one\n2. two\n3. three" },
        { "front": "{center}Text can be {#ec4899}colored{/}{/center}", "back": "{center}{#ef4444}red{/} {#f59e0b}amber{/} {#22c55e}green{/} {#3b82f6}blue{/} {#a855f7}purple{/}{/center}" },
        { "front": "{center}Furigana{/center}", "back": "{center}{漢字|かんじ} means *Chinese characters*.{/center}" },
        { "front": "{center}Cards can talk{/center}", "back": "{center}Press play: {tts:en}Hello from Stella!{/tts}\nAnd in Japanese: {tts:ja}こんにちは{/tts}{/center}" },
        { "front": "{center}And do math{/center}", "back": "{center}$$e^{i\\pi} + 1 = 0$$\nEuler's identity, with $e$, $i$, $\\pi$, $1$ and $0$.{/center}" },
        { "front": "{center}Everything at once{/center}", "back": "{center}**Bold**, {#22c55e}color{/}, {tts:en}speech{/tts}, {漢字|かんじ} and $x^2$ in one card.{/center}" }
      ]
